# GCP
GCP_PROJECT_ID=
BQ_DATASET=pme_risk
BQ_LOCATION=US

# Gemini
GOOGLE_API_KEY=

# BigQuery (opcional, se usar service account)
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Run / deploy (Fase 3)
RUN_REGION=us-central1
RUN_SERVICE=pme-risk-api
RUN_SERVICE_ACCOUNT=
DRIFT_N_LAUDOS=100
# Segredo compartilhado da demo pública — POST /laudos exige header X-API-Key
# Vazio/ausente = endpoint aberto (só para desenvolvimento local)
API_KEY_SECRET=
