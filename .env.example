# GCP
GCP_PROJECT_ID=
BQ_DATASET=pme_risk
BQ_LOCATION=US

# Gemini
GOOGLE_API_KEY=

# BigQuery (opcional, se usar service account)
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Run / deploy (Fase 3)
RUN_REGION=us-central1
RUN_SERVICE=pme-risk-api
RUN_SERVICE_ACCOUNT=
DRIFT_N_LAUDOS=100
# Chave do header X-API-Key (POST /laudos). No Cloud Run fica no Secret Manager
# (pme-risk-api-key); aqui serve para chamar a API e para criar/rotacionar o
# segredo via deploy_api.sh. Vazio/ausente em dev local = endpoint aberto.
API_KEY_SECRET=

# Eval comparativo de modelos (eval/laudo/extrator_openai_compat.py) — só eval,
# a API em produção usa Gemini/Vertex AI. Endpoint compatível com OpenAI.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
