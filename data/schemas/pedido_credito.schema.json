{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PedidoCredito",
  "description": "Schema do pedido de crédito PME — também vira BaseModel Pydantic em agents/schemas.py",
  "type": "object",
  "properties": {
    "setor": {
      "type": "string",
      "enum": [
        "agropecuaria",
        "industria_extrativa",
        "industria_transformacao",
        "eletricidade_gas",
        "agua_esgoto_residuos",
        "construcao",
        "comercio",
        "transporte_armazenagem",
        "alojamento_alimentacao",
        "informacao_comunicacao",
        "financeiro_seguros",
        "atividades_imobiliarias",
        "profissionais_cientificas_tecnicas",
        "administrativas_servicos_complementares",
        "administracao_publica",
        "educacao",
        "saude_servicos_sociais",
        "artes_cultura_esporte",
        "outros_servicos",
        "servicos_domesticos",
        "organismos_internacionais"
      ],
      "description": "Seção CNAE 2.0 da atividade principal (agents/setores.py)"
    },
    "atividade": {
      "type": [
        "string",
        "null"
      ],
      "description": "Descrição livre do negócio (ex: padaria) — usada no laudo, não avaliada"
    },
    "porte": {
      "type": "string",
      "enum": [
        "MEI",
        "ME",
        "EPP"
      ],
      "description": "Porte da empresa"
    },
    "uf": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "UF com 2 letras maiúsculas"
    },
    "anos_operacao": {
      "type": "number",
      "minimum": 0,
      "description": "Anos de operação da empresa"
    },
    "faturamento_anual_declarado": {
      "type": "number",
      "minimum": 0,
      "description": "Faturamento anual em BRL — sempre ⚠️ declarado pelo solicitante"
    },
    "valor_solicitado": {
      "type": "number",
      "minimum": 0,
      "description": "Valor do crédito solicitado em BRL"
    },
    "prazo_meses": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Prazo de pagamento em meses (opcional — nem sempre mencionado)"
    },
    "finalidade": {
      "type": "string",
      "description": "Finalidade do crédito (texto livre)"
    },
    "cnpj": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{14}$",
      "description": "CNPJ — se presente, habilita enriquecimento via quimera-core"
    }
  },
  "required": [
    "setor",
    "porte",
    "uf",
    "anos_operacao",
    "faturamento_anual_declarado",
    "valor_solicitado",
    "finalidade"
  ]
}
